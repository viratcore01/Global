# ---------------------------------------------------------------------------
# Global Cinema Opportunity Radar - environment template
# Copy to `.env` and fill in what you actually use. Everything is optional;
# the deterministic pipeline works without any paid service or API key.
# ---------------------------------------------------------------------------

# Where the project lives (optional; auto-detected from config/profile.yaml)
# RADAR_HOME=C:/Users/you/Global
# Display/reporting only: scheduling and deadlines always use a fixed IST
# offset (UTC+05:30), so this cannot shift the day boundary.
RADAR_TIMEZONE=Asia/Kolkata
RADAR_LOG_LEVEL=INFO

# SQLite / data locations (relative paths resolve under RADAR_HOME)
# RADAR_DB=data/radar.db
# RADAR_CONFIG_DIR=config
# RADAR_DATA_DIR=data

# --- HTTP fetch identity ----------------------------------------------------
# Be honest and contactable. Some sites will still reject non-browser clients.
# The contact URL is appended to every User-Agent automatically (unless it is
# already present in RADAR_USER_AGENT). Site owners should be able to reach you.
RADAR_USER_AGENT=GlobalCinemaRadar/1.0 (personal research)
RADAR_CONTACT_URL=
RADAR_MAX_BYTES=5242880
RADAR_GLOBAL_CONCURRENCY=4
RADAR_DOMAIN_RATE_SECONDS=2.0
RADAR_RESPECT_ROBOTS=true

# --- ntfy notifications -----------------------------------------------------
# Use a self-hosted ntfy with auth for best privacy, or ntfy.sh with long
# random topic names (the topic name is the password on the public server).
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace-with-a-long-random-alert-topic
NTFY_REPLY_TOPIC=replace-with-a-long-random-reply-topic
# Access token for publishing/subscribing to a protected topic:
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxx
# Separate token for the reply topic; defaults to NTFY_TOKEN.
# NTFY_REPLY_TOKEN=

# Shared secret used to sign Apply/Ignore/Scam button payloads.
# `python -m radar init` generates one if this is empty.
RADAR_REPLY_SECRET=

# Alert policy. The thresholds below override config/profile.yaml; leave them
# empty to use the profile values (instant 80 / digest 55 by default).
RADAR_INSTANT_THRESHOLD=
RADAR_DIGEST_THRESHOLD=
RADAR_DAILY_ALERT_CAP=15
RADAR_QUIET_START=23
RADAR_QUIET_END=7
RADAR_DIGEST_MAX_ITEMS=20
RADAR_EXPLORATION_SLOTS=2
# Send each digest item as its own low-priority message with buttons:
RADAR_DIGEST_INDIVIDUAL=false

# --- Email / IMAP -----------------------------------------------------------
# Gmail: enable 2FA and create an App Password. Use the label as the folder.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Optional: only ingest mail with this Gmail label (folder name), e.g. Radar
# IMAP_LABEL_FOLDER=Radar
IMAP_FETCH_LIMIT=50
IMAP_POLL_SECONDS=60
IMAP_ENABLED=false

# --- SearXNG ----------------------------------------------------------------
# A sweeper only runs when its source is enabled in config/sources.yaml AND
# SEARXNG_ENABLED=true here. Enable one without the other and the job reports
# a clear "SEARXNG_ENABLED is false" error instead of failing silently.
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_ENABLED=false
SEARXNG_TIME_RANGE=day

# --- LLM (gap filling + top-slice reorder only) -----------------------------
# Groq free tier is the reference provider. Any OpenAI-compatible endpoint
# works; Ollama runs locally.
LLM_PROVIDER=none            # none | groq | openai | ollama
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CHARS=12000

# --- Embeddings -------------------------------------------------------------
# "auto" uses sentence-transformers + intfloat/multilingual-e5-small when
# installed, otherwise a deterministic hashing embedder (still real, local,
# CPU-only, and good enough to start).
RADAR_EMBEDDING_MODEL=auto
# RADAR_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RADAR_EMBEDDING_MODEL=hashing-v1

# --- Monitoring -------------------------------------------------------------
# Free healthchecks.io ping URL. The radar cannot report its own death.
HEALTHCHECKS_URL=
# Ping after every successful scheduler cycle:
HEARTBEAT_INTERVAL_MINUTES=15

# --- Browser / OCR / Discord (optional) ------------------------------------
RADAR_ENABLE_BROWSER=false
RADAR_ENABLE_OCR=false
RADAR_OCR_LANGS=eng+hin
DISCORD_BOT_TOKEN=
DISCORD_GUILD_IDS=
DISCORD_CHANNEL_IDS=

# --- Backup -----------------------------------------------------------------
# Litestream config lives in deploy/litestream.yml; set the replica URL there
# or use environment expansion (LITESTREAM_REPLICA_URL).
LITESTREAM_REPLICA_URL=
BACKUP_RETENTION_DAYS=30

# --- Dashboard --------------------------------------------------------------
RADAR_DASHBOARD_PORT=8501
# Appended to the daily digest so you can open the dashboard from your phone.
# Point this at a reachable address (Tailscale/VPN), not localhost, if you read
# alerts on another device. Leave empty to omit the line.
RADAR_DASHBOARD_URL=
